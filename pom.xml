<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 【必须】继承SpringBoot官方父依赖，自动获取统一的依赖版本管理 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.4</version>
        <relativePath/>
    </parent>

    <groupId>com.wy</groupId>
    <artifactId>online-shop</artifactId>
    <version>0.0.1</version>
    <!-- 【强制要求】父模块打包方式必须是pom，不能是jar -->
    <packaging>pom</packaging>
    <name>Online Shop Parent</name>
    <modules>
        <module>shop-common</module>
        <module>shop-web</module>
        <module>shop-admin</module>
    </modules>

    <!-- 全局属性配置，统一管理JDK版本、编码 -->
    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- 【全局依赖】所有子模块自动继承，无需重复写 -->
    <dependencies>
        <!-- Lombok：简化实体类代码，所有模块都会用到 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 测试依赖：所有模块都会用到 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- 【版本管理核心】仅锁定版本号，不实际引入依赖，子模块引用时无需写版本 -->
    <dependencyManagement>
        <dependencies>
            <!-- 锁定公共子模块的版本 -->
            <dependency>
                <groupId>com.wy</groupId>
                <artifactId>shop-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 锁定 Web 依赖版本（子模块直接引用，无需写 version） -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-web</artifactId>
                <version>3.5.4</version>
            </dependency>

            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-test</artifactId>
                <scope>test</scope>
                <version>3.5.4</version>
            </dependency>

            <!-- 【核心】MyBatis整合SpringBoot的启动器 -->
            <!-- 【替换】删除之前的mybatis-spring-boot-starter，换成MP的依赖 -->
            <!-- MyBatis-Plus 适配SpringBoot3.x 专用依赖 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>3.5.7</version>
            </dependency>
            <!-- 【核心】MySQL8.0+官方驱动 -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>8.4.0</version>
                <scope>runtime</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>

</project>